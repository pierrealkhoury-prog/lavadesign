# Lava Design — environment template.
# Copy to `.env.local` and fill in real values (never commit secrets).
# Phase 0 only requires DATABASE_URL once a database is provisioned.
# Later phases will populate the remaining keys.

# ── Database (Phase 0+) ───────────────────────────────────────────────
# Supabase or Neon PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@host:5432/lavadesign?schema=public"

# ── Auth · Clerk (Phase 2) ────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Payments · Stripe (Phase 4+) ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── File uploads · UploadThing (Phase 4) ──────────────────────────────
UPLOADTHING_TOKEN=

# ── Transactional email · Resend (Phase 1+) ──────────────────────────
# Required for the /contact form to email notifications to info@lavadesign.us.
# Get from https://resend.com/api-keys after creating an account.
RESEND_API_KEY=
# Optional override. Defaults to "Lava Design <onboarding@resend.dev>" which
# works without domain verification (Resend's sandbox sender). Once
# lavadesign.us is verified in Resend, set this to a domain address like
# "Lava Design <inquiry@lavadesign.us>".
RESEND_FROM_EMAIL=
# Optional override for the inquiry destination. Defaults to info@lavadesign.us.
# Set this during early development if the sandbox sender restricts delivery
# (e.g. INQUIRY_RECIPIENT=pierre.alkhoury@me.com). Remove once the domain is
# verified so notifications go to the studio inbox.
INQUIRY_RECIPIENT=
